@startuml mld-hrm
!theme plain
skinparam linetype ortho

title Modèle Logique de Données — hrm-core (schéma tenant)

entity "hrm_employee" as emp {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID <<FK kernel>>
    * organization_id : UUID <<FK>>
    agency_id : UUID <<FK, nullable>>
    * actor_id : UUID <<FK actor-core>>
    * matricule : VARCHAR(20) <<UNIQUE>>
    num_cnps : VARCHAR(20)
    * categorie : INT
    echelon : VARCHAR(5)
    * date_embauche : DATE
    * status : VARCHAR(20)
    department_code : VARCHAR(20)
    * mode_paiement : VARCHAR(30)
    compte_bancaire : VARCHAR(30)
    num_mobile_money : VARCHAR(15)
    operateur_mm : VARCHAR(10)
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_contract" as ctr {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    agency_id : UUID
    * employee_id : UUID <<FK>>
    * type : VARCHAR(10)
    * date_debut : DATE
    date_fin : DATE
    * salaire_base : NUMERIC(15,2)
    avantages_nature : NUMERIC(15,2)
    periode_essai : INT
    * status : VARCHAR(15)
    motif_fin : VARCHAR(255)
    document_file_id : UUID
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_dependent" as dep {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * employee_id : UUID <<FK>>
    * nom : VARCHAR(100)
    * prenom : VARCHAR(100)
    * date_naissance : DATE
    * lien_parente : VARCHAR(30)
    certificat_file_id : UUID
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_leave_balance" as lb {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * employee_id : UUID <<FK>>
    * type : VARCHAR(15)
    * acquis : NUMERIC(5,2)
    * pris : NUMERIC(5,2)
    * annee : INT
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_leave_request" as lr {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    agency_id : UUID
    * employee_id : UUID <<FK>>
    * type : VARCHAR(15)
    * date_debut : DATE
    * date_fin : DATE
    * nb_jours : NUMERIC(5,2)
    * status : VARCHAR(15)
    motif : TEXT
    valideur_party_id : UUID
    valideur_display_name : VARCHAR(150)
    date_validation : TIMESTAMPTZ
    commentaire_valideur : TEXT
    justificatif_file_id : UUID
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_loan_advance" as la {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    agency_id : UUID
    * employee_id : UUID <<FK>>
    * montant : NUMERIC(15,2)
    * solde_restant : NUMERIC(15,2)
    * mensualite : NUMERIC(15,2)
    * status : VARCHAR(15)
    * date_debut : DATE
    * nb_echeances : INT
    motif : TEXT
    approved_by : UUID
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_payroll_run" as pr {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    agency_id : UUID <<nullable, filtre optionnel>>
    * periode : VARCHAR(7) <<ex: 2026-03>>
    * status : VARCHAR(15)
    * total_brut : NUMERIC(15,2)
    * total_net : NUMERIC(15,2)
    * total_cnps_employe : NUMERIC(15,2)
    * total_cnps_employeur : NUMERIC(15,2)
    * total_irpp : NUMERIC(15,2)
    * nb_employes : INT
    calculated_at : TIMESTAMPTZ
    validated_by : UUID
    validated_at : TIMESTAMPTZ
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_payroll_entry" as pe {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * payroll_run_id : UUID <<FK>>
    * employee_id : UUID <<FK>>
    * salaire_base : NUMERIC(15,2)
    * brut : NUMERIC(15,2)
    * net : NUMERIC(15,2)
    * cnps_employe : NUMERIC(15,2)
    * cnps_employeur : NUMERIC(15,2)
    * irpp : NUMERIC(15,2)
    * cac : NUMERIC(15,2)
    primes : NUMERIC(15,2)
    retenues : NUMERIC(15,2)
    avances_deduites : NUMERIC(15,2)
    * payment_status : VARCHAR(15)
    * payment_channel : VARCHAR(30)
    account_ref : VARCHAR(30)
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_payslip_line" as pl {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * payroll_entry_id : UUID <<FK>>
    * libelle : VARCHAR(100)
    * type : VARCHAR(15)
    base : NUMERIC(15,2)
    taux : NUMERIC(8,5)
    * montant : NUMERIC(15,2)
    * ordre_affichage : INT
}

entity "hrm_training" as tr {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    agency_id : UUID
    * intitule : VARCHAR(200)
    organisme : VARCHAR(150)
    * date_debut : DATE
    date_fin : DATE
    cout : NUMERIC(15,2)
    nb_places : INT
    lieu : VARCHAR(150)
    * status : VARCHAR(15)
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_training_enrollment" as te {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * training_id : UUID <<FK>>
    * employee_id : UUID <<FK>>
    * status : VARCHAR(15)
    note_evaluation : NUMERIC(5,2)
    attestation_file_id : UUID
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_performance_review" as rv {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * employee_id : UUID <<FK>>
    evaluateur_party_id : UUID
    evaluateur_display_name : VARCHAR(150)
    * periode : VARCHAR(20)
    note_globale : NUMERIC(5,2)
    commentaires : TEXT
    plan_action : TEXT
    * status : VARCHAR(15)
    --
    * created_by : UUID
    * created_at : TIMESTAMPTZ
    * updated_by : UUID
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "hrm_review_objective" as ro {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * review_id : UUID <<FK>>
    * description : TEXT
    * poids : NUMERIC(5,2)
    note_atteinte : NUMERIC(5,2)
    commentaire : TEXT
}



entity "hrm_job_offer" as jo {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * title : VARCHAR(150)
    * department_code : VARCHAR(20)
    * status : VARCHAR(20)
    publication_date : DATE
    closing_date : DATE
}

entity "hrm_application" as app {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * job_offer_id : UUID <<FK>>
    * candidate_party_id : UUID
    * status : VARCHAR(20)
    cv_file_id : UUID
}

entity "hrm_interview" as iv {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * application_id : UUID <<FK>>
    * interview_type : VARCHAR(20)
    scheduled_at : TIMESTAMPTZ
    result : VARCHAR(20)
}

entity "hrm_onboarding_task" as ob {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * application_id : UUID <<FK>>
    * employee_id : UUID <<FK>>
    * label : VARCHAR(120)
    * status : VARCHAR(20)
}

entity "hrm_timesheet" as ts {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    * period : VARCHAR(7)
    * normal_hours : NUMERIC(8,2)
    overtime_hours : NUMERIC(8,2)
    * status : VARCHAR(20)
}

entity "hrm_attendance_event" as atd {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    * event_time : TIMESTAMPTZ
    * event_type : VARCHAR(10)
    source : VARCHAR(20)
}

entity "hrm_expense_report" as exr {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    mission_order_id : UUID <<FK>>
    * status : VARCHAR(20)
    * total_amount : NUMERIC(15,2)
}

entity "hrm_expense_line" as exl {
    * **id** : UUID <<PK>>
    --
    * report_id : UUID <<FK>>
    * expense_date : DATE
    * category : VARCHAR(40)
    * amount : NUMERIC(15,2)
    receipt_file_id : UUID
}

entity "hrm_mission_order" as mo {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    * destination : VARCHAR(150)
    * start_date : DATE
    * end_date : DATE
    * status : VARCHAR(20)
}

entity "hrm_medical_visit" as mv {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    * visit_date : DATE
    * aptitude_status : VARCHAR(30)
    next_due_date : DATE
}

entity "hrm_medical_certificate" as mc {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    * certificate_type : VARCHAR(40)
    * issue_date : DATE
    expiry_date : DATE
}

entity "hrm_skill" as sk {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * code : VARCHAR(40)
    * label : VARCHAR(150)
    * family : VARCHAR(80)
}

entity "hrm_employee_skill" as esk {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * employee_id : UUID <<FK>>
    * skill_id : UUID <<FK>>
    * level : INT
}

entity "hrm_training_budget" as tb {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * fiscal_year : INT
    * amount_allocated : NUMERIC(15,2)
    * amount_committed : NUMERIC(15,2)
}

entity "hrm_social_declaration" as sd {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * declaration_type : VARCHAR(30)
    * period : VARCHAR(7)
    * status : VARCHAR(20)
    file_id : UUID
}

entity "hrm_rh_kpi_snapshot" as kpi {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID
    * organization_id : UUID
    * period : VARCHAR(7)
    * turnover_rate : NUMERIC(8,3)
    * absenteeism_rate : NUMERIC(8,3)
}

' Relations
emp ||--o{ ctr : employee_id
emp ||--o{ dep : employee_id
emp ||--o{ lb : employee_id
emp ||--o{ lr : employee_id
emp ||--o{ la : employee_id
emp ||--o{ te : employee_id
emp ||--o{ rv : employee_id

pr ||--o{ pe : payroll_run_id
pe ||--o{ pl : payroll_entry_id
pe }o--|| emp : employee_id

tr ||--o{ te : training_id

rv ||--o{ ro : review_id


jo ||--o{ app : job_offer_id
app ||--o{ iv : application_id
app ||--o{ ob : application_id

emp ||--o{ ts : employee_id
emp ||--o{ atd : employee_id
emp ||--o{ exr : employee_id
emp ||--o{ mo : employee_id
emp ||--o{ mv : employee_id
emp ||--o{ mc : employee_id
emp ||--o{ esk : employee_id

exr ||--o{ exl : report_id
mo ||--o{ exr : mission_order_id

sk ||--o{ esk : skill_id
tr }o--|| tb : budget_id (logical)
pr ||--o{ sd : period (logical)

@enduml
