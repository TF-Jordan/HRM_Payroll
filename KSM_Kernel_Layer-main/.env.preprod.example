SPRING_PROFILES_ACTIVE=preprod
JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=25"

MANAGEMENT_SERVER_PORT=8081
IWM_MANAGEMENT_PUBLIC_PORT=8081
IWM_GATEWAY_PUBLIC_HTTP_PORT=80
IWM_GATEWAY_PUBLIC_HTTPS_PORT=443
IWM_GATEWAY_RATE_LIMIT=100r/s
IWM_GATEWAY_RATE_LIMIT_BURST=200
IWM_GATEWAY_TENANT_RATE_LIMIT=180r/s
IWM_GATEWAY_TENANT_RATE_LIMIT_BURST=360
IWM_GATEWAY_CONNECTION_LIMIT=200
IWM_GATEWAY_TENANT_CONNECTION_LIMIT=300
IWM_TENANT_REQUEST_QUOTA_ENABLED=true
IWM_TENANT_REQUEST_QUOTA_LIMIT=1800
IWM_TENANT_REQUEST_QUOTA_WINDOW=1m
IWM_TENANT_REQUEST_QUOTA_FAIL_OPEN=true

IWM_R2DBC_URL=r2dbc:postgresql://postgres:5432/iwm
IWM_R2DBC_USERNAME=iwm
IWM_R2DBC_PASSWORD=replace-me
IWM_R2DBC_POOL_ENABLED=true
IWM_R2DBC_POOL_INITIAL_SIZE=15
IWM_R2DBC_POOL_MAX_SIZE=80
IWM_R2DBC_POOL_MAX_IDLE_TIME=20m
IWM_R2DBC_POOL_MAX_ACQUIRE_TIME=8s

IWM_LIQUIBASE_URL=jdbc:postgresql://postgres:5432/iwm
IWM_LIQUIBASE_USERNAME=iwm
IWM_LIQUIBASE_PASSWORD=replace-me

IWM_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
IWM_OUTBOX_KAFKA_CONCURRENCY=3
IWM_OUTBOX_RELAY_BATCH_SIZE=250
IWM_OUTBOX_RELAY_DELIVERY_CONCURRENCY=6
IWM_OUTBOX_REPLAY_ON_STARTUP_MAX_EVENTS=5000
IWM_OUTBOX_REPLAY_ON_STARTUP_CONSUMER_CONCURRENCY=6

IWM_REDIS_PERMISSION_CACHE_ENABLED=true
IWM_REDIS_HOST=redis
IWM_REDIS_PORT=6379
IWM_REDIS_PASSWORD=

IWM_ELASTICSEARCH_SEARCH_ENABLED=true
IWM_ELASTICSEARCH_URIS=http://elasticsearch:9200

IWM_OUTBOX_RELAY_ENABLED=true
IWM_OUTBOX_ALLOW_MANUAL_RELAY_ONLY=false
IWM_OUTBOX_REPLAY_ON_STARTUP_ENABLED=true

IWM_BOOTSTRAP_CLIENT_ENABLED=true
IWM_BOOTSTRAP_CLIENT_ID=preprod-platform-backend
IWM_BOOTSTRAP_CLIENT_NAME=Preprod Platform Backend
IWM_BOOTSTRAP_CLIENT_SECRET=replace-me
IWM_MANAGEMENT_API_KEY=replace-me
IWM_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private-key.pem
IWM_JWT_KEY_ID=iwm-key-1
IWM_JWT_ISSUER=iwm-backend-preprod
IWM_JWT_ACCESS_TOKEN_TTL=15m
